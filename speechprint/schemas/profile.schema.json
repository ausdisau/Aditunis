{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adtunis:speechprint:profile:v1",
  "title": "SpeechPrint speaker profile (separate from identifying account records)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "speaker_id",
    "language_tags",
    "speech_observations",
    "access_preferences"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^profile_[a-zA-Z0-9_-]{4,80}$"
    },
    "speaker_id": {
      "type": "string",
      "pattern": "^spk_[a-zA-Z0-9_-]{4,80}$"
    },
    "language_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "clinical_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diagnoses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "provenance"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "code_system": {
                "type": "string"
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "participant_report",
                  "clinician_record"
                ]
              },
              "clinician_reviewed": {
                "type": "boolean"
              }
            }
          }
        },
        "cp_motor_presentation": {
          "type": "string",
          "enum": [
            "spastic",
            "dyskinetic_dystonic",
            "dyskinetic_choreoathetoid",
            "ataxic",
            "mixed",
            "not_recorded"
          ]
        },
        "dysarthria_clinical_type": {
          "type": "string",
          "enum": [
            "spastic",
            "flaccid",
            "ataxic",
            "hypokinetic",
            "hyperkinetic",
            "unilateral_umn",
            "mixed",
            "undetermined",
            "no_dysarthria",
            "not_assessed"
          ]
        },
        "cfcs_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "assessment_notes_ref": {
          "type": "string",
          "description": "Opaque secure record reference; no health notes in Git"
        }
      }
    },
    "speech_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_code",
          "subsystem",
          "value",
          "method",
          "source"
        ],
        "properties": {
          "feature_code": {
            "type": "string",
            "minLength": 1
          },
          "subsystem": {
            "type": "string",
            "enum": [
              "articulation",
              "phonation",
              "prosody",
              "resonance",
              "respiration"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "perceptual",
              "instrumental",
              "participant_report"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "participant_report",
              "speech_pathologist",
              "trained_annotator",
              "instrument_measurement",
              "researcher_hypothesis"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "units": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "access_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correction_modes",
        "aac_fallback"
      ],
      "properties": {
        "correction_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tap",
              "keyboard",
              "switch",
              "voice",
              "eye_gaze",
              "supporter_assisted"
            ]
          }
        },
        "aac_fallback": {
          "type": "boolean"
        },
        "response_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "interface_language": {
          "type": "string"
        },
        "user_lexicon_ref": {
          "type": "string",
          "description": "Private encrypted lexicon reference; no names in public repo"
        },
        "captions_enabled": {
          "type": "boolean"
        }
      }
    },
    "profile_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "description": "Clinical context is optional and must never be reverse-inferred from speech observations."
}
