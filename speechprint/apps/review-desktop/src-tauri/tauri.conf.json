{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeechPrint Research Review",
  "version": "0.1.0",
  "identifier": "org.australiandisability.speechprint.review",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpeechPrint Research Review",
        "width": 960,
        "height": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' "
    }
  },
  "bundle": {
    "active": false
  }
}
